FROM node:18-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
ARG REACT_APP_REGISTRY_URL
ARG REACT_APP_SCHEDULER_URL
ARG REACT_APP_MANAGER_URL
ARG REACT_APP_SESSION_URL
RUN REACT_APP_REGISTRY_URL=$REACT_APP_REGISTRY_URL \
    REACT_APP_SCHEDULER_URL=$REACT_APP_SCHEDULER_URL \
    REACT_APP_MANAGER_URL=$REACT_APP_MANAGER_URL \
    REACT_APP_SESSION_URL=$REACT_APP_SESSION_URL \
    npm run build

FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
